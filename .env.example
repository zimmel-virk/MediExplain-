# Docker / AWS academic-deployment example.
# Local macOS setup uses backend/.env created by setup_macos.sh instead.
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite+aiosqlite:////app/data/mediexplain.db
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
DIARIZATION_ENABLED=false
HF_TOKEN=
NLI_ENABLED=true
OCR_ENGINE=auto
DEFAULT_TIMEZONE=Asia/Karachi
ALLOW_CLOUD_TTS_FALLBACK=false
PUBLIC_BASE_URL=https://mediexplain.example.org
CORS_ORIGINS=https://mediexplain.example.org

WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
